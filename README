#to make the styling nice i always need to update first the pre html of the publication page before regenerating the whole site 
pandoc --citeproc \
       --bibliography mypublications.bib \
       --csl nature_modified.csl \
       --lua-filter filters/highlight-author.lua \
       -f markdown -t html \
       src/publications.md -o src/publications_bib.html

#to insert new publications inline in qmd 
sed '/<!-- PUBLICATIONS_HERE -->/r src/publications_bib.html' publications_src.qmd   | sed '/<!-- PUBLICATIONS_HERE -->/d' > publications.qmd
